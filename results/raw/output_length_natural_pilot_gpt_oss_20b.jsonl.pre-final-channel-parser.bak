 I'd choose 85. Let's pick 85.assistantfinalScore: 85", "score": null, "score_parse_ok": false, "score_parse_error": "no_labelled_score", "format_ok": false, "format_error": "expected_exact_score_format", "generated_tokens": 316, "hit_max_new_tokens": false, "generation_seconds": 20.54019831912592, "metadata": {"effective_generation_seed": 3952271181, "max_new_tokens_setting": "context_window", "max_new_tokens_limit": 130744}}
